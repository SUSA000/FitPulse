<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_app_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="610dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Sleep Settings -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/bg_warm"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:id="@+id/rlSleep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tvSleepTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sleep Reminder"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swSleepReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tvSleepTimeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvSleepTitle"
                        android:layout_marginTop="16dp"
                        android:text="Reminder time"
                        android:textAppearance="?attr/textAppearanceBody1" />

                    <TextView
                        android:id="@+id/tvSleepTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvSleepTitle"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="16dp"
                        android:text="22:00"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textColor="?attr/colorPrimary" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hydration Settings -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_warm"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:id="@+id/rlHydration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvHydrationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hydration Reminder"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swHydrationReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tvHydrationIntervalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvHydrationTitle"
                        android:layout_marginTop="16dp"
                        android:text="Remind me every"
                        android:textAppearance="?attr/textAppearanceBody1" />

                    <Spinner
                        android:id="@+id/spinnerHydrationInterval"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvHydrationTitle"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="16dp" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Habit Settings -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/bg_warm"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:id="@+id/rlHabit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvHabitTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Habit Reminder"
                        android:textAppearance="?attr/textAppearanceHeadline6" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swHabitReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/tvHabitTimeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvHabitTitle"
                        android:layout_marginTop="16dp"
                        android:text="Reminder time"
                        android:textAppearance="?attr/textAppearanceBody1" />

                    <TextView
                        android:id="@+id/tvHabitTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvHabitTitle"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="16dp"
                        android:text="09:00"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textColor="?attr/colorPrimary" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medicine Reminders -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/bg_warm"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvMedicineTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medicine Reminder 💊"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swMedicineReminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />

                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMedicineTimes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <Button
                        android:id="@+id/btnAddMedicineTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Add Reminder Time"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/primary_orange"
                        android:textColor="@android:color/white"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
