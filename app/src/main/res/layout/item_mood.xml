<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:padding="12dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvEmoji"
        android:layout_width="40dp" android:layout_height="wrap_content"
        android:text="🙂" android:textSize="20sp"/>

    <TextView
        android:id="@+id/tvWhen"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:paddingStart="12dp"
        android:text="2025-10-03 09:30"/>

    <TextView
        android:id="@+id/tvNote"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Feeling good"/>
</LinearLayout>
